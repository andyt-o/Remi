# FastAPI service
PORT=8000

# Mock integrations server used by the MCP tools and MVP benchmarks.
# From Daytona, set this to a hostname reachable from the sandbox (not localhost).
MOCK_POS_BASE_URL=http://localhost:8001

# Mock staff identity for this MCP server process. Seed accounts: 105=server, 106=manager.
# Set per-client/server process; the role is resolved from the mock staff directory.
REMI_MCP_ACCOUNT_ID=105

# Mock server latency profiles: low_latency | typical_cloud | rush_hour_degraded
REMI_MOCK_PROFILE=typical_cloud

# Direct SMS (Twilio): all three values are required. Keep credentials server-side.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Email / SMS Gateway configuration (Resend or SMTP)
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL="Remi Alerts <onboarding@resend.dev>"
# Optional test recipient override for free Resend sandbox accounts:
# RESEND_TEST_RECIPIENT_OVERRIDE=your_verified_account@email.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Optional custom staff contact numbers for SMS templates
# DEFAULT_MANAGER_SIGNATURE=Taylor Morgan
# RESTAURANT_CONTACT_PHONE=(619) 555-0144
# FLOOR_CONTACT_PHONE=(619) 555-0182

# Optional custom latency overrides (milliseconds)
# ORACLE_POS_MIN_LATENCY_MS=15
# ORACLE_POS_MAX_LATENCY_MS=45
# SEVEN_SHIFTS_MIN_LATENCY_MS=30
# SEVEN_SHIFTS_MAX_LATENCY_MS=70
# MARKETMAN_MIN_LATENCY_MS=40
# MARKETMAN_MAX_LATENCY_MS=90

# Provider credentials stay on the backend. ElevenLabs powers the staff-session TTS greeting and speech transcription.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Optional model overrides for generated speech and STT:
# ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL_ID=scribe_v1
# DAYTONA_API_KEY=
# Optional Daytona connection settings; keep these on the agent service.
# DAYTONA_API_URL=
# DAYTONA_TARGET=
# DAYTONA_TASK_IMAGE=python:3.12-slim
# DAYTONA_TASK_TIMEOUT_SECONDS=120
# LLM Model Configuration (OpenRouter or OpenAI-compatible provider)
# LLM_API_KEY=sk-or-v1-your-key-here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_PROVIDER_ONLY=relace/fp4
