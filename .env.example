# FastAPI service
PORT=8000

# Mock integrations server used by the MCP tools and MVP benchmarks.
# From Daytona, set this to a hostname reachable from the sandbox (not localhost).
MOCK_POS_BASE_URL=http://localhost:8001

# Mock server latency profiles: low_latency | typical_cloud | rush_hour_degraded
REMI_MOCK_PROFILE=typical_cloud

# Optional custom latency overrides (milliseconds)
# ORACLE_POS_MIN_LATENCY_MS=15
# ORACLE_POS_MAX_LATENCY_MS=45
# SEVEN_SHIFTS_MIN_LATENCY_MS=30
# SEVEN_SHIFTS_MAX_LATENCY_MS=70
# MARKETMAN_MIN_LATENCY_MS=40
# MARKETMAN_MAX_LATENCY_MS=90

# Provider credentials are optional until live provider integrations are enabled.
# ELEVENLABS_API_KEY=
# DAYTONA_API_KEY=
# LLM_API_KEY=
