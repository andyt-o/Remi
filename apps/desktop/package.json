{
  "name": "remi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Remi restaurant voice-agent demonstration",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "wait-on http://127.0.0.1:5173 && electron .",
    "start": "node scripts/check-electron.cjs && concurrently -k \"npm:dev\" \"npm:electron\"",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.remi.desktop",
    "productName": "Remi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icons/remi.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/remi.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/linux"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
